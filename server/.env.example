# 复制这个文件为 .env，然后填入你的 API Key
# cp .env.example .env

# 硅基流动 API Key
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用的模型（可选，默认 Qwen/Qwen2.5-7B-Instruct）
# 推荐选项：
#   Qwen/Qwen2.5-7B-Instruct    （快速、便宜）
#   Qwen/Qwen2.5-72B-Instruct   （质量更高，费用稍高）
#   deepseek-ai/DeepSeek-V2.5   （质量很高）
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# 服务端口（默认 3001）
PORT=3001
